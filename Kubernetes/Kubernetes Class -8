how to attach multiple configmap to multiple pods like below

vim pod.yml

---
apiVersion: v1
kind: Pod
metadata:
  name: pod2
spec:
  containers:
    - name: cont1
      image: nginx
      ports: 
        - containers: 80
      env:
        - name: env1
          valueFrom:
            configMapkeyRef:
              name: cm1
              key: company
        - name: env2
          valueFrom:
            configMapkeyRef:
              name: cm3
              key: area


