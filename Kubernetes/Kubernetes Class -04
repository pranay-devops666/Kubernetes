vim service.yml

---
apiVersion: v1------------> to view which version we need to give here the command was ----->kubectl api-resources | grep -i "services"
kind: Service
metadata:
  name: firstservice
spec:
  type: ClusterIP
  selector:
    app: swiggy
  ports:
    - port: 80
      targetPort: 80


:wq

