mkdir pranay

cd pranay

openssl genrsa -out pranay.key 2048 ------------> command to generate a key (Generate a key using openssl)
pranay.key (it means need to be create in that format way), 2048 ----> means 2048 bytes

openssl req -new -key pranay.key-out pranay.csr -subj "/CN=mustafa/O=group1" --------------> Command to generate CSR (Generate a client sign request (CSR)) 

openssl -req x509 -req -in pranay.csr -CA ~/.minikube/ca.crt -CAkey ~/.minikube/ca.key -CAcreateserial -out pranay.crt -days 500 -----------> command to Generate the certificate (CRT)


lets create user

kubectl config set-credentials pranay --client-certificate=mustafa.crt--client.key=mustafa.key ---------------> command to create user

lets check the context

kubectl config view ------------> command to view context

now need to create the context

kubectl config set-context devops --cluster=minikube --user=pranay -------------> command to create context
devops---------> context name, minikube------ cluster name, pranay-------> user

kubectl config view ------------> command to view context

